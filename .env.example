# Server-only secrets. NEVER commit real values.
# Copy this file to ".env" (development) and ".env.test" (testing) and fill in.

# Better Auth secret (>= 32 chars, high entropy).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public base URL of the auth server.
BETTER_AUTH_URL=http://localhost:4321

# PostgreSQL connection string (server-only). AuthCore owns this database.
DATABASE_URL=postgres://authcore:authcore_dev@localhost:5432/authcore_dev

# Email verification token lifetime in seconds.
# Development: 3600 (1 hour). Test: use a short value (e.g. 2) for deterministic tests.
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=3600

# Password-reset token lifetime in seconds. Successful resets revoke all sessions.
PASSWORD_RESET_EXPIRES_IN_SECONDS=3600
ACCOUNT_DELETION_EXPIRES_IN_SECONDS=3600

# Google OAuth credentials (server-only). Required for Google sign-in.
# Leave empty to disable Google OAuth.
# Setup: Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
# Authorized redirect URI: http://localhost:4321/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set AUTH_ENV=test to load .env.test instead of .env (used by test scripts).
AUTH_ENV=development
