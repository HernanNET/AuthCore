{
  "name": "authcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone authentication module (Better Auth + PostgreSQL) — Phase 1: registration only.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "start": "node ./dist/server/entry.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "cross-env AUTH_ENV=test tsx scripts/migrate.ts",
    "test:serve": "cross-env AUTH_ENV=test astro dev --port 4321",
    "test:e2e": "cross-env AUTH_ENV=test playwright test",
    "test:e2e:ui": "cross-env AUTH_ENV=test playwright test --ui"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
