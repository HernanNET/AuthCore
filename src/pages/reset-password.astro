---
// Phase 6: consume Better Auth's one-time password-reset token.
const token = Astro.url.searchParams.get("token") ?? "";
const hasTokenError = Astro.url.searchParams.has("error") || token.length === 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Choose a new password — AuthCore</title>
  </head>
  <body>
    <main class="container">
      <h1>Choose a new password</h1>

      {hasTokenError ? (
        <section id="invalid-state" role="alert">
          <h2>Reset link unavailable</h2>
          <p>This password-reset link is invalid or has expired.</p>
          <a class="button-link" href="/forgot-password">Request a new link</a>
        </section>
      ) : (
        <>
          <section id="form-section">
            <form id="reset-form" data-token={token} novalidate>
              <div class="field">
                <label for="password">New password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" required />
              </div>
              <div class="field">
                <label for="confirm-password">Confirm new password</label>
                <input id="confirm-password" name="confirm-password" type="password" autocomplete="new-password" required />
              </div>
              <p id="error-message" role="alert" hidden></p>
              <button id="reset-button" type="submit">Update password</button>
            </form>
          </section>
          <section id="success-state" aria-live="polite" hidden>
            <h2>Password updated</h2>
            <p>Your password has been changed and existing sessions have been signed out.</p>
            <a class="button-link" href="/login">Sign in</a>
          </section>
        </>
      )}
    </main>

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7f9; color: #111; margin: 0; padding: 2rem; }
      .container { max-width: 26rem; margin: 2rem auto; background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1.75rem; }
      h1 { font-size: 1.4rem; margin: 0 0 1.25rem; }
      h2 { font-size: 1.2rem; margin: 0 0 .5rem; }
      #invalid-state h2 { color: #c92a2a; }
      #success-state h2 { color: #2b8a3e; }
      .field { display: flex; flex-direction: column; margin-bottom: 1rem; }
      label { font-size: .85rem; margin-bottom: .35rem; font-weight: 600; }
      input { padding: .6rem .7rem; border: 1px solid #c7ccd2; border-radius: 6px; font-size: 1rem; }
      input:focus { outline: 2px solid #4c6ef5; outline-offset: 1px; }
      button, .button-link { display: block; width: 100%; box-sizing: border-box; padding: .7rem; border: 0; border-radius: 6px; background: #4c6ef5; color: #fff; font-size: 1rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; }
      button:disabled { background: #9aa4b2; cursor: progress; }
      #error-message { color: #c92a2a; background: #fff5f5; border: 1px solid #ffd0d0; padding: .6rem .7rem; border-radius: 6px; margin: 0 0 1rem; font-size: .9rem; }
    </style>

    {!hasTokenError && (
      <script>
        import { resetPassword } from "@/lib/auth-facade";

        const form = document.getElementById("reset-form") as HTMLFormElement;
        const button = document.getElementById("reset-button") as HTMLButtonElement;
        const passwordInput = document.getElementById("password") as HTMLInputElement;
        const confirmInput = document.getElementById("confirm-password") as HTMLInputElement;
        const errorEl = document.getElementById("error-message") as HTMLParagraphElement;
        const formSection = document.getElementById("form-section") as HTMLElement;
        const successState = document.getElementById("success-state") as HTMLElement;
        const token = form.dataset.token ?? "";
        let submitting = false;

        function showError(message: string): void {
          errorEl.textContent = message;
          errorEl.hidden = false;
        }

        form.addEventListener("submit", async (event: SubmitEvent) => {
          event.preventDefault();
          if (submitting) return;
          errorEl.hidden = true;
          const password = passwordInput.value;
          const confirmation = confirmInput.value;
          if (password.length < 8) {
            showError("Password must be at least 8 characters.");
            passwordInput.focus();
            return;
          }
          if (password.length > 128) {
            showError("Password must be no more than 128 characters.");
            passwordInput.focus();
            return;
          }
          if (password !== confirmation) {
            showError("Passwords do not match.");
            confirmInput.focus();
            return;
          }

          submitting = true;
          button.disabled = true;
          button.textContent = "Updating…";
          try {
            const { error } = await resetPassword({ token, newPassword: password });
            if (error) {
              showError("This password-reset link is invalid or has expired.");
              button.disabled = false;
              button.textContent = "Update password";
              submitting = false;
              return;
            }
            history.replaceState({}, "", "/reset-password?status=success");
            formSection.hidden = true;
            successState.hidden = false;
          } catch {
            showError("Unable to update the password. Please try again.");
            button.disabled = false;
            button.textContent = "Update password";
            submitting = false;
          }
        });
      </script>
    )}
  </body>
</html>
