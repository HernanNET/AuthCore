---
import { getCurrentSession } from "@/lib/session";

const session = await getCurrentSession(Astro.request.headers);
if (!session) {
  return Astro.redirect("/login");
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Delete account — AuthCore</title>
  </head>
  <body>
    <main class="container">
      <h1>Delete account</h1>
      <div class="warning" role="note">
        <strong>This action is permanent.</strong>
        <p>Your user, linked sign-in accounts, and every active session will be deleted.</p>
      </div>

      <section id="form-section">
        <form id="delete-account-form" novalidate>
          <div class="field">
            <label for="confirmation">Type <strong>DELETE</strong> to confirm</label>
            <input id="confirmation" name="confirmation" type="text" autocomplete="off" required />
          </div>
          <label class="checkbox-row">
            <input id="understand" name="understand" type="checkbox" />
            <span>I understand that this account cannot be recovered.</span>
          </label>
          <p id="error-message" role="alert" hidden></p>
          <button id="delete-account-button" type="submit">Send deletion link</button>
        </form>
      </section>

      <section id="success-state" aria-live="polite" hidden>
        <h2>Check your email</h2>
        <p>A final deletion link has been sent. Your account still exists until you use it.</p>
      </section>

      <p class="back-link"><a href="/account">Cancel and return to account</a></p>
    </main>

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7f9; color: #111; margin: 0; padding: 2rem; }
      .container { max-width: 28rem; margin: 2rem auto; background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1.75rem; }
      h1 { color: #c92a2a; font-size: 1.4rem; margin: 0 0 1rem; }
      h2 { color: #2b8a3e; font-size: 1.2rem; margin: 0 0 .5rem; }
      .warning { background: #fff5f5; border: 1px solid #ffc9c9; border-radius: 7px; padding: .85rem; margin-bottom: 1.25rem; }
      .warning p { margin: .4rem 0 0; line-height: 1.45; }
      .field { display: flex; flex-direction: column; margin-bottom: 1rem; }
      label { font-size: .9rem; margin-bottom: .35rem; }
      input[type="text"] { padding: .6rem .7rem; border: 1px solid #c7ccd2; border-radius: 6px; font-size: 1rem; }
      input[type="text"]:focus { outline: 2px solid #c92a2a; outline-offset: 1px; }
      .checkbox-row { display: flex; align-items: flex-start; gap: .55rem; line-height: 1.4; margin-bottom: 1rem; }
      .checkbox-row input { margin-top: .2rem; }
      button { width: 100%; padding: .7rem; border: 0; border-radius: 6px; background: #c92a2a; color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; }
      button:disabled { background: #adb5bd; cursor: progress; }
      #error-message { color: #c92a2a; background: #fff5f5; border: 1px solid #ffd0d0; padding: .6rem .7rem; border-radius: 6px; margin: 0 0 1rem; font-size: .9rem; }
      .back-link { text-align: center; margin: 1.25rem 0 0; font-size: .9rem; }
      a { color: #4c6ef5; text-decoration: none; }
    </style>

    <script>
      import { requestAccountDeletion } from "@/lib/auth-facade";

      const form = document.getElementById("delete-account-form") as HTMLFormElement;
      const confirmation = document.getElementById("confirmation") as HTMLInputElement;
      const understand = document.getElementById("understand") as HTMLInputElement;
      const button = document.getElementById("delete-account-button") as HTMLButtonElement;
      const error = document.getElementById("error-message") as HTMLParagraphElement;
      const formSection = document.getElementById("form-section") as HTMLElement;
      const successState = document.getElementById("success-state") as HTMLElement;
      let submitting = false;

      function showError(message: string): void {
        error.textContent = message;
        error.hidden = false;
      }

      form.addEventListener("submit", async (event: SubmitEvent) => {
        event.preventDefault();
        if (submitting) return;
        error.hidden = true;
        if (confirmation.value !== "DELETE") {
          showError("Type DELETE exactly to continue.");
          confirmation.focus();
          return;
        }
        if (!understand.checked) {
          showError("Confirm that you understand this action cannot be undone.");
          understand.focus();
          return;
        }

        submitting = true;
        button.disabled = true;
        button.textContent = "Sending…";
        try {
          const { error: requestError } = await requestAccountDeletion();
          if (requestError) throw new Error("Request failed");
          confirmation.value = "";
          understand.checked = false;
          formSection.hidden = true;
          successState.hidden = false;
        } catch {
          showError("Unable to request account deletion. Please try again.");
          button.disabled = false;
          button.textContent = "Send deletion link";
          submitting = false;
        }
      });
    </script>
  </body>
</html>
