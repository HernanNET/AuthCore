---
const success = Astro.url.searchParams.get("status") === "success";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Account deletion — AuthCore</title>
  </head>
  <body>
    <main class="container">
      {success ? (
        <section id="deletion-success">
          <h1>Account deleted</h1>
          <p>Your AuthCore user, linked accounts, and sessions were permanently deleted.</p>
        </section>
      ) : (
        <section id="deletion-error">
          <h1>Deletion failed</h1>
          <p>The deletion link is invalid, expired, already used, or does not match the signed-in account.</p>
        </section>
      )}
      <p class="back-link"><a href="/register">Create an account</a> · <a href="/login">Sign in</a></p>
    </main>

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7f9; color: #111; margin: 0; padding: 2rem; }
      .container { max-width: 28rem; margin: 2rem auto; background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1.75rem; }
      h1 { font-size: 1.4rem; margin: 0 0 1rem; }
      #deletion-success h1 { color: #2b8a3e; }
      #deletion-error h1 { color: #c92a2a; }
      p { line-height: 1.5; }
      .back-link { text-align: center; margin: 1.25rem 0 0; font-size: .9rem; }
      a { color: #4c6ef5; text-decoration: none; }
    </style>
  </body>
</html>
