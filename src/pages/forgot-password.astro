---
// Phase 6: request a native Better Auth password-reset link.
// The success response is intentionally identical for known and unknown emails.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot password — AuthCore</title>
  </head>
  <body>
    <main class="container">
      <h1>Reset your password</h1>
      <p class="intro">Enter your email and we'll send a reset link if an account exists.</p>

      <section id="form-section">
        <form id="forgot-form" novalidate>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <p id="error-message" role="alert" hidden></p>
          <button id="forgot-button" type="submit">Send reset link</button>
        </form>
      </section>

      <section id="success-state" aria-live="polite" hidden>
        <h2>Check your email</h2>
        <p>If an account exists for that address, a password-reset link has been sent.</p>
      </section>

      <p class="back-link"><a href="/login">Back to sign in</a></p>
    </main>

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7f9; color: #111; margin: 0; padding: 2rem; }
      .container { max-width: 26rem; margin: 2rem auto; background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1.75rem; }
      h1 { font-size: 1.4rem; margin: 0 0 .65rem; }
      h2 { color: #2b8a3e; font-size: 1.2rem; margin: 0 0 .5rem; }
      .intro { color: #6c757d; line-height: 1.5; margin: 0 0 1.25rem; }
      .field { display: flex; flex-direction: column; margin-bottom: 1rem; }
      label { font-size: .85rem; margin-bottom: .35rem; font-weight: 600; }
      input { padding: .6rem .7rem; border: 1px solid #c7ccd2; border-radius: 6px; font-size: 1rem; }
      input:focus { outline: 2px solid #4c6ef5; outline-offset: 1px; }
      button { width: 100%; padding: .7rem; border: 0; border-radius: 6px; background: #4c6ef5; color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; }
      button:disabled { background: #9aa4b2; cursor: progress; }
      #error-message { color: #c92a2a; background: #fff5f5; border: 1px solid #ffd0d0; padding: .6rem .7rem; border-radius: 6px; margin: 0 0 1rem; font-size: .9rem; }
      .back-link { text-align: center; margin: 1.25rem 0 0; font-size: .9rem; }
      a { color: #4c6ef5; text-decoration: none; }
    </style>

    <script>
      import { requestPasswordReset } from "@/lib/auth-facade";

      const form = document.getElementById("forgot-form") as HTMLFormElement;
      const button = document.getElementById("forgot-button") as HTMLButtonElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const errorEl = document.getElementById("error-message") as HTMLParagraphElement;
      const formSection = document.getElementById("form-section") as HTMLElement;
      const successState = document.getElementById("success-state") as HTMLElement;
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      let submitting = false;

      function showError(message: string): void {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      form.addEventListener("submit", async (event: SubmitEvent) => {
        event.preventDefault();
        if (submitting) return;
        errorEl.hidden = true;
        const email = emailInput.value.trim();
        if (!EMAIL_RE.test(email)) {
          showError("Please enter a valid email address.");
          emailInput.focus();
          return;
        }

        submitting = true;
        button.disabled = true;
        button.textContent = "Sending…";
        try {
          const { error } = await requestPasswordReset(email);
          if (error) {
            showError(error.status === 429
              ? "Too many reset requests. Please wait before trying again."
              : "Unable to request a reset link. Please try again.");
            button.disabled = false;
            button.textContent = "Send reset link";
            submitting = false;
            return;
          }
          formSection.hidden = true;
          successState.hidden = false;
        } catch {
          showError("Unable to request a reset link. Please try again.");
          button.disabled = false;
          button.textContent = "Send reset link";
          submitting = false;
        }
      });
    </script>
  </body>
</html>
