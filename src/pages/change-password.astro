---
import { getCurrentSession } from "@/lib/session";

// Phase 7 is available only to an authenticated browser session.
const session = await getCurrentSession(Astro.request.headers);
if (!session) {
  return Astro.redirect("/login");
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change password — AuthCore</title>
  </head>
  <body>
    <main class="container">
      <h1>Change password</h1>
      <p class="intro">Changing your password will sign out your other sessions.</p>

      <section id="form-section">
        <form id="change-password-form" novalidate>
          <div class="field">
            <label for="current-password">Current password</label>
            <input id="current-password" name="current-password" type="password" autocomplete="current-password" required />
          </div>
          <div class="field">
            <label for="new-password">New password</label>
            <input id="new-password" name="new-password" type="password" autocomplete="new-password" required />
          </div>
          <div class="field">
            <label for="confirm-password">Confirm new password</label>
            <input id="confirm-password" name="confirm-password" type="password" autocomplete="new-password" required />
          </div>
          <p id="error-message" role="alert" hidden></p>
          <button id="change-password-button" type="submit">Change password</button>
        </form>
      </section>

      <section id="success-state" aria-live="polite" hidden>
        <h2>Password changed</h2>
        <p>Your password was updated. Other sessions have been signed out.</p>
        <a class="button-link" href="/account">Back to account</a>
      </section>

      <p class="back-link"><a href="/account">Cancel</a></p>
    </main>

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f6f7f9; color: #111; margin: 0; padding: 2rem; }
      .container { max-width: 26rem; margin: 2rem auto; background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1.75rem; }
      h1 { font-size: 1.4rem; margin: 0 0 .65rem; }
      h2 { color: #2b8a3e; font-size: 1.2rem; margin: 0 0 .5rem; }
      .intro { color: #6c757d; line-height: 1.5; margin: 0 0 1.25rem; }
      .field { display: flex; flex-direction: column; margin-bottom: 1rem; }
      label { font-size: .85rem; margin-bottom: .35rem; font-weight: 600; }
      input { padding: .6rem .7rem; border: 1px solid #c7ccd2; border-radius: 6px; font-size: 1rem; }
      input:focus { outline: 2px solid #4c6ef5; outline-offset: 1px; }
      button, .button-link { display: block; width: 100%; box-sizing: border-box; padding: .7rem; border: 0; border-radius: 6px; background: #4c6ef5; color: #fff; font-size: 1rem; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; }
      button:disabled { background: #9aa4b2; cursor: progress; }
      #error-message { color: #c92a2a; background: #fff5f5; border: 1px solid #ffd0d0; padding: .6rem .7rem; border-radius: 6px; margin: 0 0 1rem; font-size: .9rem; }
      .back-link { margin: 1.25rem 0 0; text-align: center; font-size: .9rem; }
      .back-link a { color: #4c6ef5; text-decoration: none; }
    </style>

    <script>
      import { changePassword } from "@/lib/auth-facade";

      const form = document.getElementById("change-password-form") as HTMLFormElement;
      const button = document.getElementById("change-password-button") as HTMLButtonElement;
      const currentInput = document.getElementById("current-password") as HTMLInputElement;
      const newInput = document.getElementById("new-password") as HTMLInputElement;
      const confirmInput = document.getElementById("confirm-password") as HTMLInputElement;
      const errorEl = document.getElementById("error-message") as HTMLParagraphElement;
      const formSection = document.getElementById("form-section") as HTMLElement;
      const successState = document.getElementById("success-state") as HTMLElement;
      let submitting = false;

      function showError(message: string): void {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      function safeError(error: { message?: string; code?: string } | null | undefined): string {
        const value = `${error?.code ?? ""} ${error?.message ?? ""}`.toLowerCase();
        if (value.includes("credential_account_not_found") || value.includes("credential account")) {
          return "This account does not have password sign-in enabled.";
        }
        if (value.includes("invalid_password") || value.includes("invalid password")) {
          return "Current password is incorrect.";
        }
        if (value.includes("too_short") || value.includes("too short")) {
          return "Password must be at least 8 characters.";
        }
        return "Unable to change the password. Please try again.";
      }

      form.addEventListener("submit", async (event: SubmitEvent) => {
        event.preventDefault();
        if (submitting) return;
        errorEl.hidden = true;
        const currentPassword = currentInput.value;
        const newPassword = newInput.value;
        const confirmation = confirmInput.value;

        if (!currentPassword) {
          showError("Please enter your current password.");
          currentInput.focus();
          return;
        }
        if (newPassword.length < 8) {
          showError("Password must be at least 8 characters.");
          newInput.focus();
          return;
        }
        if (newPassword.length > 128) {
          showError("Password must be no more than 128 characters.");
          newInput.focus();
          return;
        }
        if (newPassword !== confirmation) {
          showError("Passwords do not match.");
          confirmInput.focus();
          return;
        }
        if (newPassword === currentPassword) {
          showError("Choose a password different from your current password.");
          newInput.focus();
          return;
        }

        submitting = true;
        button.disabled = true;
        button.textContent = "Changing…";
        try {
          const { error } = await changePassword({ currentPassword, newPassword });
          if (error) {
            showError(safeError(error));
            button.disabled = false;
            button.textContent = "Change password";
            submitting = false;
            return;
          }
          currentInput.value = "";
          newInput.value = "";
          confirmInput.value = "";
          formSection.hidden = true;
          successState.hidden = false;
        } catch {
          showError("Unable to change the password. Please try again.");
          button.disabled = false;
          button.textContent = "Change password";
          submitting = false;
        }
      });
    </script>
  </body>
</html>
